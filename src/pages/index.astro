---
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import { getNotes } from '../lib';
const notes = await getNotes();
const longNotes = notes.filter((n) => n.data.long);
---
<Base>
  {longNotes.length > 0 && (
    <section class="long-notes">
      <h2>長めの記事</h2>
      <NoteList notes={longNotes} />
    </section>
  )}
  {longNotes.length > 0 && <h2>すべてのメモ</h2>}
  <p class="meta">{notes.length} 件のメモ</p>
  <NoteList notes={notes} />
</Base>

<style>
  h2 { font-size: 1.1rem; margin: 0 0 .25rem; }
  .long-notes { margin-bottom: 2.5rem; padding: .75rem 1rem .25rem; border: 1px solid var(--border); border-radius: 8px; }
  .long-notes :global(ul.list) { margin: 0; }
  .long-notes :global(ul.list li:last-child) { border-bottom: none; }
</style>
