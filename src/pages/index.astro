---
import Base from '../layouts/Base.astro';
import { getNotes, url, formatDate } from '../lib';
const notes = await getNotes();
---
<Base>
  <p class="meta">{notes.length} 件のメモ</p>
  <ul class="list">
    {notes.map((n) => (
      <li>
        <time>{formatDate(n.data.date)}</time>
        <a href={url(`/notes/${n.id}/`)}>{n.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
