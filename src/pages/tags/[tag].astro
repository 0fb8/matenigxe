---
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../lib';

export async function getStaticPaths() {
  const notes = await getNotes();
  const tags = [...new Set(notes.flatMap((n) => n.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { notes: notes.filter((n) => n.data.tags.includes(tag)) } }));
}

const { tag } = Astro.params;
const { notes } = Astro.props;
---
<Base title={`#${tag}`}>
  <h1>#{tag}</h1>
  <NoteList notes={notes} currentTag={tag} />
</Base>
